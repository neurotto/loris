+/**
+ * fetchPreparedJSON: fetchJSON for data a server prepares on demand. While
+ * the server answers 503 with state "fetching", wait Retry-After seconds and
+ * ask again.
+ *
+ * @param {string} url - The url to fetch
+ * @param {Function} onWait - Called with the server's message while waiting,
+ *                            with null once the data is served
+ * @param {object} params - The request params
+ * @returns {Promise} - The json data, null if unavailable
+ */
+export const fetchPreparedJSON = (
+  url: string,
+  onWait: (message: string | null, final: boolean) => void,
+  params?: RequestInit,
+) : Promise<any> =>
+  fetch(url, params).then((response) => {
+    if (response.status !== 503) {
+      onWait(null, true);
+      return response.ok ? response.json() : null;
+    }
+    return response.json().catch(() => ({})).then((body) => {
+      const message = body?.error || response.statusText;
+      if (body?.state !== 'fetching') {
+        onWait(message, true);
+        return null;
+      }
+      onWait(message, false);
+      const seconds = Math.min(
+        Math.max(Number(response.headers.get('Retry-After')) || 5, 1),
+        60,
+      );
+      return new Promise((resolve) => setTimeout(resolve, seconds * 1000))
+        .then(() => fetchPreparedJSON(url, onWait, params));
+    });
+  });
+
