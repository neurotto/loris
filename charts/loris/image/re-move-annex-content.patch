+    /**
+     * Ask for the content of every imaging browser file that is fetched on
+     * demand from its site (RE-MOVE), so one viewer request fetches them all.
+     *
+     * @param iterable $dbfiles The results of the database query
+     *
+     * @return ?array null when every file can be served, else the status of
+     *                an unavailable file, or else of a file being fetched
+     */
+    private function _pendingContent(iterable $dbfiles) : ?array
+    {
+        $imagepath = \NDB_Factory::singleton()->config()->getSetting('imagePath');
+        $pending   = null;
+        foreach ($dbfiles as $row) {
+            if ($row['Source'] !== 'ImagingBrowser') {
+                continue;
+            }
+            $status = \LORIS\ReMove\AnnexContent::check($imagepath . $row['File']);
+            if ($status !== null
+                && ($pending === null || $status['state'] === 'unavailable')
+            ) {
+                $pending = $status;
+            }
+        }
+        return $pending;
+    }
