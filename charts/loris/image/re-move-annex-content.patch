+    private function _reMoveContent(
+        string $downloadpath,
+        $file
+    ): ?ResponseInterface {
+        if (!is_string($file) || $file === '' || str_contains($file, '..')) {
+            return null;
+        }
+        if (preg_match(
+            '#^(re-move-chunks/[^/]+/[^/]+/[^/]+/[^/]+\.chunks)(/.*)?$#',
+            $file,
+            $match
+        ) !== 1
+        ) {
+            $status = \LORIS\ReMove\AnnexContent::check($downloadpath . $file);
+            return $status === null ? null
+                : \LORIS\ReMove\AnnexContent::response($status);
+        }
+        $index = ($match[2] ?? '') === '/index.json';
+        if (!$index && is_file($downloadpath . $match[1] . '/index.json')) {
+            return null;
+        }
+        $filePath = \NDB_Factory::singleton()->database()->pselectOne(
+            "SELECT MIN(pf.FilePath) FROM physiological_file pf
+               JOIN physiological_parameter_file ppf
+                 USING (PhysiologicalFileID)
+               JOIN parameter_type pt USING (ParameterTypeID)
+             WHERE pt.Name = 'electrophysiology_chunked_dataset_path'
+               AND ppf.Value = :chunks",
+            ['chunks' => $match[1]]
+        );
