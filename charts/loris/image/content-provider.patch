index 0000000..fbd283f
--- /dev/null
+++ b/src/ContentProvider.php
@@ -0,0 +1,275 @@
+<?php declare(strict_types=1);
+
+namespace LORIS;
+
+use \Psr\Http\Message\ResponseInterface;
+
+/**
+ * Resolves optional, provider-managed content without exposing backend IDs.
+ */
+class ContentProvider
+{
+    private const NAME = '[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}';
+    private const MAX_RETRY_AFTER = 60;
+
+    /**
+     * Request missing content from the configured provider.
+     *
+     * @param string $path Absolute path of the file LORIS serves
+     *
+     * @return ?array null when content can be served or is not provider-managed
+     */
+    public static function check(string $path): ?array
+    {
+        $url = getenv('LORIS_CONTENT_PROVIDER_URL');
+        $contentPath = self::_locate($path);
+        if (!$url || $contentPath === null || is_file($path)) {
+            return null;
+        }
+
+        $status = self::_request($url, '/content', ['path' => $contentPath], 10);
+        if ($status['state'] === 'ready') {
+            return is_file($path) ? null : self::_pending(
+                'The provider reported ready content, but it is not visible locally yet.'
+            );
+        }
+        return $status;
+    }
+
+    /**
+     * Request EEG chunks for a registered source recording.
+     *
+     * @param string $dataDir  Data directory, with a trailing slash
+     * @param string $filePath Recording FilePath relative to the data directory
+     * @param string $chunks   Registered chunk path relative to the data directory
+     * @param bool   $touch    Whether to record access to already-present chunks
+     *
+     * @return ?array null when chunks can be served or are not provider-managed
+     */
+    public static function chunks(
+        string $dataDir,
+        string $filePath,
+        string $chunks,
+        bool $touch
+    ): ?array {
+        $url = getenv('LORIS_CONTENT_PROVIDER_URL');
+        $contentPath = self::_locate($dataDir . $filePath);
+        if (!$url || $contentPath === null) {
+            return null;
+        }
+
+        $parts = explode('/', $contentPath, 3);
+        if (count($parts) !== 3) {
+            return null;
+        }
+        $digest = hash('sha256', $parts[2]);
+        $expected = 'content-provider-chunks/' . $parts[0] . '/'
+            . $parts[1] . '/' . $digest . '.chunks';
+        if ($chunks !== $expected) {
+            return null;
+        }
+        $payload = ['path' => $contentPath, 'chunkPath' => $expected];
+        if (is_file($dataDir . $chunks . '/index.json')) {
+            if ($touch) {
+                self::_request($url, '/chunks', $payload, 1);
+            }
+            return null;
+        }
+
+        $status = self::_request(
+            $url,
+            '/chunks',
+            $payload,
+            10
+        );
+        if ($status['state'] === 'ready') {
+            return is_file($dataDir . $chunks . '/index.json') ? null
+                : self::_pending(
+                    'The provider reported ready chunks, but they are not visible locally yet.'
+                );
+        }
+        return $status;
+    }
+
+    /**
+     * Build the common response for content that is not ready yet.
+     *
+     * @param array $status A result returned by check() or chunks()
+     *
+     * @return ResponseInterface
+     */
+    public static function response(array $status): ResponseInterface
+    {
+        return (new \LORIS\Http\Response\JsonResponse(
+            [
+                'error'      => $status['message'],
+                'state'      => $status['state'],
+                'retryAfter' => $status['retryAfter'],
+            ],
+            503
+        ))->withHeader('Retry-After', (string)$status['retryAfter']);
+    }
+
+    /**
+     * Resolve the logical site/dataset path before a source symlink is followed.
+     */
+    private static function _locate(string $path): ?string
+    {
+        $root = rtrim(
+            getenv('LORIS_CONTENT_ROOT') ?: '/data/loris/data/assembly_bids',
+            '/'
+        );
+        $path = self::_normalize($path);
+        for ($hop = 0; $hop < 16; $hop++) {
+            $relative = self::_relative($path, $root);
+            if ($relative !== null) {
+                return $relative;
+            }
+            if (!is_link($path)) {
+                return null;
+            }
+            $target = readlink($path);
+            if ($target === false) {
+                return null;
+            }
+            $path = self::_normalize(
+                str_starts_with($target, '/') ? $target
+                    : dirname($path) . '/' . $target
+            );
+        }
+        return self::_relative($path, $root);
+    }
+
+    /**
+     * Validate a logical content path relative to the configured content root.
+     */
+    private static function _relative(string $path, string $root): ?string
+    {
+        if (!str_starts_with($path, $root . '/')) {
+            return null;
+        }
+        $parts = explode('/', substr($path, strlen($root) + 1));
+        if (
+            count($parts) < 3
+            || preg_match('/^' . self::NAME . '$/', $parts[0]) !== 1
+            || $parts[1] === ''
+            || str_starts_with($parts[1], '.')
+            || preg_match('//u', $parts[1]) !== 1
+            || preg_match('/^import-.+$/', $parts[0]) === 1
+            || in_array('.git', $parts, true)
+            || in_array('.', $parts, true)
+            || in_array('..', $parts, true)
+        ) {
+            return null;
+        }
+        return implode('/', $parts);
+    }
+
+    /**
+     * POST one logical path to the configured provider.
+     */
+    private static function _request(
+        string $url,
+        string $endpoint,
+        array $payload,
+        int $timeout
+    ): array {
+        $body = json_encode($payload, JSON_INVALID_UTF8_SUBSTITUTE);
+        $curl = curl_init(rtrim($url, '/') . $endpoint);
+        if ($body === false || $curl === false) {
+            error_log('Content provider request could not be initialized.');
+            return self::_unavailable('The content provider is unavailable.');
+        }
+        curl_setopt_array(
+            $curl,
+            [
+                CURLOPT_POST           => true,
+                CURLOPT_POSTFIELDS     => $body,
+                CURLOPT_HTTPHEADER     => ['Content-Type: application/json'],
+                CURLOPT_RETURNTRANSFER => true,
+                CURLOPT_CONNECTTIMEOUT => min($timeout, 2),
+                CURLOPT_TIMEOUT        => $timeout,
+            ]
+        );
+        $response = curl_exec($curl);
+        $code = curl_getinfo($curl, CURLINFO_RESPONSE_CODE);
+        $error = curl_error($curl);
+        curl_close($curl);
+        if ($response === false) {
+            error_log('Content provider request failed: ' . $error);
+            return self::_unavailable('The content provider is unavailable.');
+        }
+        $decoded = is_string($response) ? json_decode($response, true) : null;
+
+        if (
+            is_array($decoded)
+            && $code === 200
+            && ($decoded['state'] ?? null) === 'ready'
+        ) {
+            return ['state' => 'ready'];
+        }
+        if (
+            is_array($decoded)
+            && $code === 202
+            && ($decoded['state'] ?? null) === 'pending'
+        ) {
+            return [
+                'state'      => 'pending',
+                'message'    => self::_message($decoded, 'Content is being prepared.'),
+                'retryAfter' => self::_retryAfter($decoded['retryAfter'] ?? null),
+            ];
+        }
+        if (
+            is_array($decoded)
+            && $code === 404
+            && ($decoded['state'] ?? null) === 'unavailable'
+        ) {
+            return self::_unavailable(
+                self::_message($decoded, 'Content is unavailable.')
+            );
+        }
+        error_log('Content provider returned an invalid response. HTTP ' . $code);
+        return self::_unavailable('The content provider returned an invalid response.');
+    }
+
+    private static function _message(array $response, string $fallback): string
+    {
+        $message = $response['message'] ?? null;
+        return is_string($message) && $message !== ''
+            ? substr($message, 0, 500) : $fallback;
+    }
+
+    private static function _retryAfter($value): int
+    {
+        if (!is_numeric($value)) {
+            return 5;
+        }
+        return min(max((int)$value, 1), self::MAX_RETRY_AFTER);
+    }
+
+    private static function _pending(string $message): array
+    {
+        return ['state' => 'pending', 'message' => $message, 'retryAfter' => 1];
+    }
+
+    private static function _unavailable(string $message): array
+    {
+        return ['state' => 'unavailable', 'message' => $message, 'retryAfter' => 60];
+    }
+
+    private static function _normalize(string $path): string
+    {
+        $parts = [];
+        foreach (explode('/', $path) as $part) {
+            if ($part === '' || $part === '.') {
+                continue;
+            }
+            if ($part === '..') {
+                array_pop($parts);
+                continue;
+            }
+            $parts[] = $part;
+        }
+        return '/' . implode('/', $parts);
+    }
+}
