+/**
+ * fetchPreparedJSON: fetchJSON for data a server prepares on demand. While
+ * the server answers 503 with a pending state, wait Retry-After seconds and
+ * ask again, with a bounded wait that can be cancelled by the caller.
+ *
+ * @param {string} url - The url to fetch
+ * @param {Function} onWait - Called with the server's message while waiting,
+ *                            with null once the data is served
+ * @param {object} params - The request params
+ * @returns {Promise} - The json data, null if unavailable or timed out
+ */
+export const fetchPreparedJSON = (
+  url: string,
+  onWait: (message: string | null, final: boolean) => void,
+  params?: RequestInit,
+  maxWaitMs = 5 * 60 * 1000,
+) : Promise<any> => {
+  const started = Date.now();
+  const signal = params?.signal;
+  const wait = (milliseconds: number): Promise<void> =>
+    new Promise((resolve, reject) => {
+      if (signal?.aborted) {
+        const error = new Error('Content request was cancelled.');
+        error.name = 'AbortError';
+        reject(error);
+        return;
+      }
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      const abort = () => {
+        if (timer !== undefined) {
+          clearTimeout(timer);
+        }
+        signal?.removeEventListener('abort', abort);
+        const error = new Error('Content request was cancelled.');
+        error.name = 'AbortError';
+        reject(error);
+      };
+      signal?.addEventListener('abort', abort, {once: true});
+      if (signal?.aborted) {
+        abort();
+        return;
+      }
+      timer = setTimeout(() => {
+        signal?.removeEventListener('abort', abort);
+        resolve();
+      }, milliseconds);
+    });
+
+  const fetchAttempt = (): Promise<any> => {
+    const remaining = maxWaitMs - (Date.now() - started);
+    if (remaining <= 0) {
+      onWait('Timed out while waiting for content.', true);
+      return Promise.resolve(null);
+    }
+    return fetch(url, params).then((response) => {
+      if (response.status !== 503) {
+        if (!response.ok) {
+          onWait(response.statusText || 'Unable to load content.', true);
+          return null;
+        }
+        onWait(null, true);
+        return response.json();
+      }
+      return response.json().catch(() => ({})).then((body) => {
+        const message = body?.error || response.statusText || 'Content is being prepared.';
+        if (body?.state !== 'pending') {
+          onWait(message || 'Content is unavailable.', true);
+          return null;
+        }
+        onWait(message, false);
+        const seconds = Math.min(
+          Math.max(Number(response.headers.get('Retry-After')) || 5, 1),
+          60,
+        );
+        return wait(Math.min(seconds * 1000, remaining))
+          .then(fetchAttempt);
+      });
+    });
+  };
+
+  return fetchAttempt();
+};
